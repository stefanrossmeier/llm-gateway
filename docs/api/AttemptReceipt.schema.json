{
  "$defs": {
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Alias",
          "type": "string"
        },
        "provider_ref": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Provider Ref",
          "type": "string"
        },
        "configured_model": {
          "title": "Configured Model",
          "type": "string"
        },
        "upstream_model": {
          "title": "Upstream Model",
          "type": "string"
        },
        "actual_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Model"
        },
        "actual_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Provider"
        },
        "generation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Id"
        }
      },
      "required": [
        "alias",
        "provider_ref",
        "configured_model",
        "upstream_model"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "x_posts_fetched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Posts Fetched"
        },
        "x_profiles_fetched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Profiles Fetched"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "cache_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Tokens"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Receipt Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Project Id",
      "type": "string"
    },
    "principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Principal Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt": {
      "maximum": 10,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "config_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "evidence_status": {
      "default": "unavailable",
      "enum": [
        "measured",
        "estimated",
        "unavailable",
        "explicit_free",
        "cached_reuse",
        "subscription_covered",
        "simulated",
        "not_dispatched"
      ],
      "title": "Evidence Status",
      "type": "string"
    },
    "currency": {
      "const": "USD",
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "measured_usd": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Usd"
    },
    "estimated_usd": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Usd"
    },
    "protected_debit_usd": {
      "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
      "title": "Protected Debit Usd",
      "type": "string"
    },
    "contingent_exposure_usd": {
      "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
      "title": "Contingent Exposure Usd",
      "type": "string"
    },
    "pricing_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pricing Source"
    },
    "reservation_kind": {
      "default": "bound",
      "enum": [
        "bound",
        "risk_allowance",
        "simulated",
        "legacy_unclassified"
      ],
      "title": "Reservation Kind",
      "type": "string"
    },
    "usage_complete": {
      "default": false,
      "title": "Usage Complete",
      "type": "boolean"
    },
    "reconciliation_required": {
      "default": false,
      "title": "Reconciliation Required",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_id",
    "project_id",
    "principal_id",
    "request_id",
    "attempt_id",
    "attempt",
    "config_digest",
    "model",
    "protected_debit_usd",
    "contingent_exposure_usd"
  ],
  "title": "AttemptReceipt",
  "type": "object"
}
