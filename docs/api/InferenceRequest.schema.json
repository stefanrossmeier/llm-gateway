  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "alias": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Alias",
      "type": "string"
    },
    "operation": {
      "enum": [
        "chat",
        "responses",
        "decisions",
        "x_search",
        "embeddings"
      ],
      "title": "Operation",
      "type": "string"
    },
    "input": {
      "discriminator": {
        "mapping": {
          "chat": "#/$defs/ChatInput",
          "decisions": "#/$defs/DecisionsInput",
          "embeddings": "#/$defs/EmbeddingsInput",
          "responses": "#/$defs/ResponsesInput",
          "x_search": "#/$defs/XSearchInput"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChatInput"
        },
        {
          "$ref": "#/$defs/ResponsesInput"
        },
        {
          "$ref": "#/$defs/DecisionsInput"
        },
        {
          "$ref": "#/$defs/XSearchInput"
        },
        {
          "$ref": "#/$defs/EmbeddingsInput"
        }
      ],
      "title": "Input"
    },
    "context": {
      "$ref": "#/$defs/RequestContext"
    },
    "limits": {
      "$ref": "#/$defs/CallerLimits"
    }
  },
  "required": [
    "request_id",
    "alias",
    "operation",
    "input"
  ],
  "title": "InferenceRequest",
  "type": "object"
}
