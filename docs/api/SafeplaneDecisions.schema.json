{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "model": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Model",
      "type": "string"
    },
    "state": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "State",
      "type": "object"
    },
    "questions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Questions",
      "type": "object"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "timeout_seconds": {
      "default": 30,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "model",
    "state",
    "questions"
  ],
  "title": "SafeplaneDecisions",
  "type": "object"
}
