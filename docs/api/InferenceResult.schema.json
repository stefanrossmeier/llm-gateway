{
  "$defs": {
    "AttemptReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Receipt Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "principal_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Principal Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "config_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        },
        "evidence_status": {
          "default": "unavailable",
          "enum": [
            "measured",
            "estimated",
            "unavailable",
            "explicit_free",
            "cached_reuse",
            "subscription_covered",
            "simulated",
            "not_dispatched"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "measured_usd": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Usd"
        },
        "estimated_usd": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Usd"
        },
        "protected_debit_usd": {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
          "title": "Protected Debit Usd",
          "type": "string"
        },
        "contingent_exposure_usd": {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,18})?$",
          "title": "Contingent Exposure Usd",
          "type": "string"
        },
        "pricing_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Source"
        },
        "reservation_kind": {
          "default": "bound",
          "enum": [
            "bound",
            "risk_allowance",
            "simulated",
            "legacy_unclassified"
          ],
          "title": "Reservation Kind",
          "type": "string"
        },
        "usage_complete": {
          "default": false,
          "title": "Usage Complete",
          "type": "boolean"
        },
        "reconciliation_required": {
          "default": false,
          "title": "Reconciliation Required",
          "type": "boolean"
        }
      },
      "required": [
        "receipt_id",
        "project_id",
        "principal_id",
        "request_id",
        "attempt_id",
        "attempt",
        "config_digest",
        "model",
        "protected_debit_usd",
        "contingent_exposure_usd"
      ],
      "title": "AttemptReceipt",
      "type": "object"
    },
    "FunctionCall": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "title": "Arguments",
          "type": "string"
        },
        "parsed_arguments": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Arguments"
        },
        "diagnostic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostic"
        }
      },
      "required": [
        "call_id",
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "JsonValue": {},
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Alias",
          "type": "string"
        },
        "provider_ref": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Provider Ref",
          "type": "string"
        },
        "configured_model": {
          "title": "Configured Model",
          "type": "string"
        },
        "upstream_model": {
          "title": "Upstream Model",
          "type": "string"
        },
        "actual_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Model"
        },
        "actual_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Provider"
        },
        "generation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Id"
        }
      },
      "required": [
        "alias",
        "provider_ref",
        "configured_model",
        "upstream_model"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "SafeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "title": "Message",
          "type": "string"
        },
        "advice": {
          "enum": [
            "query_receipt",
            "reconcile",
            "correct_request"
          ],
          "title": "Advice",
          "type": "string"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Trace Id",
          "type": "string"
        },
        "receipt_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Id"
        }
      },
      "required": [
        "code",
        "message",
        "advice",
        "trace_id"
      ],
      "title": "SafeError",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "x_posts_fetched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Posts Fetched"
        },
        "x_profiles_fetched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Profiles Fetched"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "cache_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Tokens"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Trace Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Project Id",
      "type": "string"
    },
    "config_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "in_progress",
        "completed",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "output_status": {
      "enum": [
        "pending",
        "valid",
        "refused",
        "truncated",
        "invalid_document",
        "invalid_tool_arguments",
        "provider_failed",
        "unavailable"
      ],
      "title": "Output Status",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "function_calls": {
      "items": {
        "$ref": "#/$defs/FunctionCall"
      },
      "title": "Function Calls",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/AttemptReceipt"
      },
      "title": "Receipts",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafeError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish Reason"
    },
    "provider_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Provider Metadata",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "project_id",
    "config_digest",
    "execution_status",
    "output_status",
    "model"
  ],
  "title": "InferenceResult",
  "type": "object"
}
